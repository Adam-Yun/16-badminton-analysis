# Copy this file to .env and fill in your actual paths.
# .env is gitignored and never committed.

# ── extract_frames.py ─────────────────────────────────────────────────────────
# Path to the input video file
VIDEO_PATH=data/raw_videos/match1.mp4

# Directory where extracted frames will be saved
OUTPUT_DIR=data/frames/match1

# ── label.py ──────────────────────────────────────────────────────────────────
# Directory containing extracted frames to label
FRAMES_DIR=data/frames/match1

# Path to write (or resume) the annotations CSV
ANNOTATIONS_CSV=data/annotations/labels.csv

# Optional: glob pattern to match frame files (default: frame_*.jpg)
# FRAME_PATTERN=frame_*.jpg

# ── train.py ──────────────────────────────────────────────────────────────────
TRAIN_EPOCHS=100
TRAIN_BATCH=8
TRAIN_LR=1e-4
TRAIN_N_FRAMES=3
TRAIN_NUM_WORKERS=4
# Optional: resume from a checkpoint
# TRAIN_RESUME=shuttle-tracker/models/weights/best.pt
